dist/
komodoc-data/
examples/*.html
# ...except this one, which is the hand-written HTML example: it is a source
# file that no tool renders, which is the whole point of it.
!examples/style-guide.html
examples/*_files/
examples/.calepin/
.envrc
.env

# The reader shell is built from web/ by bun and vite, and the README is
# copied in beside it: everything under src/shell is a build output that the
# binary embeds.
src/shell/
examples/.venv/
examples/__marimo__/
.claude

# Cargo build output.
target/

# The Cargo lockfile is committed: this builds a binary, not a library.
!Cargo.lock

# Installed by bun from web/bun.lock, which is committed: a lockfile is a
# build input, the tree it installs is not.
web/node_modules/
